# Frontend (Create React App) environment example.
#
# Create React App inlines every REACT_APP_* value into the JavaScript bundle
# that ships to the browser. Never put a secret in this file.
# Backend configuration lives in backend/.env (see backend/.env.example).
# Quick Add photo reading uses GEMINI_API_KEY on the backend, not a REACT_APP_* value.

# Base URL of the backend API, including the /api suffix.
# `npm start` loads `.env.development` (local backend).
# `npm run build` / Render loads `.env.production` (server backend).
# Opening the site on localhost always uses http://localhost:5000/api
# regardless of this value.
REACT_APP_API_URL=http://localhost:5000/api

# Razorpay PUBLIC key id only. The key secret must stay on the backend.
REACT_APP_RAZORPAY_KEY_ID=

# Feature flag for the admin reel -> product import screen.
REACT_APP_ENABLE_REEL_PRODUCT_IMPORT=true

# Prevents the dev server from opening a browser tab on start.
BROWSER=none
